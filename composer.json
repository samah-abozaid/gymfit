{
	"autoload":
	{
		"classmap":
			[
				"app/controllers/",
				"app/managers/",
				"app/models/",
				"app/services/"
			]
	},
	"require":
	{
		"vlucas/phpdotenv": "^5.6",
		"phpmailer/phpmailer": "^7.0"
	},
	"require-dev":
	{
		"symfony/var-dumper": "^6.0",
		"phpunit/phpunit": "^13.2"
	},
	"config": {
		"allow-plugins": {
			"php-http/discovery": true
		}
	},
	"scripts":
	{
		"test": "phpunit"
	}
}
