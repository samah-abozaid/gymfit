# Environment: "development" (affiche les erreurs) ou "production" (les cache)
APP_ENV="production"

# Database info
DB_NAME="databasename"
DB_USER="username"
DB_PASSWORD="password"
DB_CHARSET="utf8"
DB_HOST="db.3wa.io"

# Mail (SMTP) — en prod, utiliser un vrai SMTP, pas le sandbox Mailtrap
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USERNAME="username"
MAIL_PASSWORD="password"
MAIL_FROM="contact@example.com"
MAIL_FROM_NAME="GymFit"
MAIL_TO="contact@example.com"
MAIL_TO_NAME="GymFit"
