<script>
    /* Vérifie en temps réel que les mots de passe correspondent */
    const np = document.getElementById('new_password');
    const cp = document.getElementById('confirm_password');
    const msg = document.getElementById('pwd-match-msg');

    function checkMatch() {
        if (!cp.value) { msg.textContent = ''; return; }
        if (np.value === cp.value) {
            msg.textContent = '✓ Passwords match';
            msg.style.color = '#28a745';
        } else {
            msg.textContent = '✗ Passwords do not match';
            msg.style.color = '#C0392B';
        }
    }
    np.addEventListener('input', checkMatch);
    cp.addEventListener('input', checkMatch);
</script>
