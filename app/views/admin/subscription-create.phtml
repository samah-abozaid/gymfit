<script>
    const form  = document.getElementById('sub-form');
    const name  = document.getElementById('f-name');
    const price = document.getElementById('f-price');

    function showError(el, msg) {
        el.style.borderColor = '#C0392B';
        document.getElementById('err-' + el.id.replace('f-', '')).textContent = msg;
    }
    function clearError(el) {
        el.style.borderColor = '';
        document.getElementById('err-' + el.id.replace('f-', '')).textContent = '';
    }

    name.addEventListener('input',  () => clearError(name));
    price.addEventListener('input', () => clearError(price));

    form.addEventListener('submit', function(e) {
        let valid = true;

        if (name.value.trim() === '') {
            showError(name, 'Plan name is required.');
            valid = false;
        }
        if (price.value === '' || isNaN(price.value) || parseFloat(price.value) < 0) {
            showError(price, 'Enter a valid price (0 or more).');
            valid = false;
        }

        if (!valid) e.preventDefault();
    });
</script>
