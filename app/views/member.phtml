<script>
    function calcBMI() {
        const weight = parseFloat(document.getElementById('bmi-weight').value);
        const height = parseFloat(document.getElementById('bmi-height').value);

        if (!weight || !height || weight <= 0 || height <= 0) return;

        const hm  = height / 100;
        const bmi = weight / (hm * hm);
        const bmiRounded = Math.round(bmi * 10) / 10;

        let category, color, message;
        if (bmi < 18.5) {
            category = 'Underweight'; color = '#3498db';
            message  = { title: '⚠️ Too light', text: 'Your weight is below the healthy range. Consider increasing your calorie intake and consult a nutritionist.' };
        } else if (bmi < 25) {
            category = 'Normal'; color = '#28a745';
            message  = { title: '✅ Great shape!', text: 'Your BMI is in the ideal range. Keep up your healthy lifestyle and training routine.' };
        } else if (bmi < 30) {
            category = 'Overweight'; color = '#ffc107';
            message  = { title: '⚡ Watch out', text: 'You are slightly above the healthy range. Regular cardio sessions and a balanced diet can help you get back on track.' };
        } else {
            category = 'Obese'; color = '#C0392B';
            message  = { title: '🚨 Dangerous zone', text: 'Your BMI indicates a high health risk. We strongly recommend consulting a doctor and starting a supervised fitness program.' };
        }

        document.getElementById('bmi-value').textContent = bmiRounded;
        const catEl = document.getElementById('bmi-cat');
        catEl.textContent = category;
        catEl.style.color = color;

        const msgEl = document.getElementById('bmi-message');
        msgEl.style.borderLeftColor = color;
        msgEl.innerHTML = `<strong style="color:${color}">${message.title}</strong>${message.text}`;

        /* position du marqueur : BMI de 10 à 40 → 0% à 100% */
        const pct = Math.min(Math.max((bmi - 10) / 30 * 100, 2), 98);
        document.getElementById('bmi-marker').style.left = pct + '%';

        document.getElementById('bmi-result').classList.add('show');
    }

    /* Calcul au Enter */
    ['bmi-weight', 'bmi-height'].forEach(id => {
        document.getElementById(id).addEventListener('keydown', e => {
            if (e.key === 'Enter') calcBMI();
        });
    });
</script>
